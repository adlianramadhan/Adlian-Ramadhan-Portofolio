---
const jobs = [
  {
    period: 'Apr 2024 - Present',
    company: 'PT Vascomm Solusi Teknologi',
    role: 'Quality Assurance',
    desc: 'Testing BTN QRIS, BTN Merchant, WebView POS, Smart Residence, API, mobile, backend, and dashboard platforms.',
  },
  // {
  //   period: '2024',
  //   company: 'PT Texio Mitra Digitalisasi Indonesia',
  //   role: 'Quality Assurance',
  //   desc: 'Testing HR, CRM, recruitment, landing page, and management systems across web and mobile views.',
  // },
  {
    period: '2022 - 2023',
    company: 'PT Gear Inc Services Indonesia',
    role: 'Quality Assurance Trainer',
    desc: 'Handled quality monitoring, calibration, reporting, evaluation, and QA process validation.',
  },
];

---

<section id="experience" class="py-12 sm:py-16 lg:py-20 bg-light-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12">
      <div class="lg:col-span-4">
        <p class="text-xs font-semibold tracking-[0.2em] text-mint uppercase mb-1.5 sm:mb-2">Experience</p>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-dark mb-2 sm:mb-4">Work Journey</h2>
        <p class="text-sm sm:text-base text-body leading-relaxed">My professional journey in quality assurance across multiple industries and enterprise-level projects.</p>
      </div>

      <div class="lg:col-span-8">
        <div class="relative">
          <div class="absolute left-4 top-2 bottom-2 w-0.5 bg-border"></div>
          <div class="space-y-5 sm:space-y-8">
            {jobs.map((job, i) => (
              <div class="relative pl-12 group">
                <div class:list={["absolute left-2.5 top-1.5 w-3 h-3 rounded-full border-2 transition-colors duration-300", i === 0 ? "bg-mint border-mint" : "bg-white border-border group-hover:border-mint"]}></div>
                <div class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-border hover:border-mint-200">
                  <span class="text-[10px] sm:text-xs font-medium text-muted">{job.period}</span>
                  <h3 class="text-base sm:text-lg font-bold text-dark mt-0.5 sm:mt-1">{job.company}</h3>
                  <p class="text-xs sm:text-sm font-semibold text-mint mt-0.5">{job.role}</p>
                  <p class="text-xs sm:text-sm text-muted mt-1.5 sm:mt-2 leading-relaxed">{job.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

  { icon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z', label: 'WhatsApp', value: '+62 812-3248-1169', href: 'https://wa.me/6281232481169' },
];

const opportunities = [
  { title: 'Freelance QA Projects', desc: 'Available for part-time or project-based QA work' },
  { title: 'Enterprise Software Testing', desc: 'End-to-end testing for enterprise applications' },
  { title: 'Fintech Quality Assurance', desc: 'Specialized testing for payment & fintech systems' },
  { title: 'Full-time Positions', desc: 'Open to the right opportunity with QA engineering' },
];
---

<section id="contact" class="py-12 sm:py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-6 sm:mb-10">
      <p class="text-xs font-semibold tracking-[0.2em] text-mint uppercase mb-1.5 sm:mb-2">Contact</p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-dark">Let's Work <span class="italic font-light text-mint">Together</span></h2>
      <p class="text-sm sm:text-base text-body mt-2 sm:mt-3 max-w-xl leading-relaxed">Open for freelance QA projects, enterprise software testing, and fintech quality assurance opportunities.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-10">
      <!-- Contact details -->
      <div class="space-y-4">
        {contactInfo.map(item => (
          <a href={item.href ?? undefined} target={item.href?.startsWith('http') ? '_blank' : undefined} rel={item.href?.startsWith('http') ? 'noopener noreferrer' : undefined} class:list={["flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-light-bg rounded-xl transition-colors duration-200 group", item.href ? "hover:bg-mint-50 focus:outline-none focus:ring-4 focus:ring-mint-100" : "cursor-default"]}>
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white flex items-center justify-center shrink-0 shadow-sm group-hover:bg-mint transition-colors">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-mint group-hover:text-white transition-colors" fill={item.label === 'GitHub' || item.label === 'WhatsApp' ? 'currentColor' : 'none'} stroke={item.label === 'GitHub' || item.label === 'WhatsApp' ? 'none' : 'currentColor'} viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/></svg>
            </div>
            <div class="min-w-0">
              <p class="text-[10px] sm:text-xs font-semibold text-muted uppercase tracking-wider">{item.label}</p>
              <p class="text-xs sm:text-sm font-medium text-dark mt-0.5 truncate">{item.value}</p>
            </div>
          </a>
        ))}
      </div>
      <!-- Opportunities -->
      <div>
        <h3 class="text-base sm:text-lg font-bold text-dark mb-3 sm:mb-4">Open For Opportunities</h3>
        <div class="space-y-2 sm:space-y-3">
          {opportunities.map(opp => (
            <div class="flex items-start gap-3 p-3 sm:p-4 bg-light-bg rounded-xl hover:bg-mint-50 transition-colors duration-200 group">
              <div class="w-2 h-2 rounded-full bg-mint mt-1.5 shrink-0 group-hover:scale-125 transition-transform"></div>
              <div>
                <p class="text-xs sm:text-sm font-bold text-dark">{opp.title}</p>
                <p class="text-[10px] sm:text-xs text-muted mt-0.5">{opp.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

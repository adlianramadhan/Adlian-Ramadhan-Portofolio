  //   desc: 'QA for community app flows, user journeys, content visibility, mobile responsiveness, and BTN ecosystem integration touchpoints.',
  //   badges: ['Community', 'Mobile', 'BTN', 'Regression'],
  //   color: 'from-red-400 to-blue-500',
  //   logo: '/images/projects/bale-community.png',
  //   logoAlt: 'Bale Community by BTN logo',
  //   logoTone: 'p-6',
  // },
  {
    num: '05',
    title: 'Talent Go',
    desc: 'QA for talent database, user access management, search validation, landing page checks, and end-to-end talent management workflows.',
    badges: ['Talent DB', 'Search', 'Web Admin', 'Landing Page'],

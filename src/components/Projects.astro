  {
    num: '01',
    title: 'BTN QRIS | BTN Merchant',
    desc: 'QA for QRIS CPM, MPM, TAP, settlement, refund, Snap API, merchant onboarding, UUPDP compliance, and backend/API improvements.',
    badges: ['QRIS', 'Open API', 'Settlement', 'Redis', 'Regression'],
    color: 'from-teal-400 to-cyan-500',
    logo: '/images/projects/btn-ecosystem.png',
    logoAlt: 'BTN Merchant logo',
    logoTone: 'p-5',
  },
  {
    num: '02',
    title: 'BTN Webview POS',
    desc: 'Validated embedded WebView integration in BTN mobile applications, covering navigation flow, redirects, session handling, and error states.',
    badges: ['WebView', 'Mobile POS', 'Navigation', 'Session'],
    color: 'from-blue-400 to-indigo-500',
    logo: '/images/projects/btn-ecosystem.png',
    logoAlt: 'BTN POS logo',
    logoTone: 'p-5',
  },
  {
    num: '03',
    title: 'BTN Bale Community',
    desc: 'Testing billing, payments, Open VA, residence configuration, user access, email notifications, dashboard reporting, APIs, and release cycles.',
    badges: ['Billing', 'Open VA', 'API', 'Regression', 'Landing Page'],
    color: 'from-purple-400 to-pink-500',
    logo: '/images/projects/bale-community.png',
    logoAlt: 'Bale Community by BTN logo',
    logoTone: 'p-4',
  },
  // {
  //   num: '04',

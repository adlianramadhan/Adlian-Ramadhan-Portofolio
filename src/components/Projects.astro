---
const projects = [
  {
    num: '01',
    title: 'BTN QRIS Ecosystem',
    desc: 'End-to-end testing for QRIS payment ecosystem across mobile, web admin, merchant dashboard, partner dashboard, POS, and BTN mobile.',
    badges: ['QRIS', 'API Testing', 'NFC', 'Web Admin'],
    color: 'from-teal-400 to-cyan-500',
  },
  {
    num: '02',
    title: 'Smart Residence',
    desc: 'Testing billing, payment, dashboard, notifications, email templates, user management, log checking, regression, and compatibility.',
    badges: ['Billing', 'Mobile', 'Dashboard', 'Web'],
    color: 'from-blue-400 to-indigo-500',
  },
  {
    num: '03',
    title: 'HR & Management Systems',
    desc: 'Testing HR, recruitment, CRM, and management platforms including E2E Recruitment, Kelola HR, Talent Go, and internal systems.',
    badges: ['HR Platform', 'API', 'CRM', 'Responsive'],
    color: 'from-purple-400 to-pink-500',
  },
];
---

<section id="projects" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="mb-12">
      <p class="text-xs font-semibold tracking-[0.2em] text-mint uppercase mb-2">Projects</p>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-3">Featured Projects</h2>
          <p class="text-body max-w-xl leading-relaxed">Some of the major projects I've been involved in quality assurance, ensuring reliability and performance.</p>
        </div>
        <a href="#" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-border text-dark text-sm font-semibold rounded-full hover:border-mint hover:text-mint transition-all duration-200 shrink-0">
          View All Projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
    <!-- Project cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {projects.map(project => (
        <div class="group bg-light-bg rounded-2xl overflow-hidden border border-border hover:border-mint-200 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
          <!-- Device mockup area -->
          <div class={`relative h-48 bg-gradient-to-br ${project.color} p-6 overflow-hidden`}>
            <span class="absolute top-4 left-4 text-5xl font-black text-white/20">{project.num}</span>
            <!-- Laptop mockup -->
            <div class="absolute bottom-3 left-1/2 -translate-x-1/2 w-40 h-24 bg-gray-800 rounded-t-lg border-2 border-gray-600 overflow-hidden shadow-xl">
              <div class="flex items-center gap-0.5 px-1.5 py-0.5 bg-gray-900">
                <span class="w-1 h-1 rounded-full bg-red-400"></span>
                <span class="w-1 h-1 rounded-full bg-yellow-400"></span>
                <span class="w-1 h-1 rounded-full bg-green-400"></span>
              </div>
              <div class="bg-white h-full p-1">
                <div class="w-full h-1.5 bg-gray-200 rounded mb-1"></div>
                <div class="w-3/4 h-1 bg-gray-100 rounded mb-0.5"></div>
                <div class="w-1/2 h-1 bg-gray-100 rounded mb-1"></div>
                <div class="grid grid-cols-3 gap-0.5">
                  <div class="h-3 bg-mint-100 rounded"></div>
                  <div class="h-3 bg-blue-100 rounded"></div>
                  <div class="h-3 bg-purple-100 rounded"></div>
                </div>
              </div>
            </div>
            <!-- Phone mockup -->
            <div class="absolute bottom-2 right-6 w-14 h-24 bg-gray-800 rounded-lg border-2 border-gray-600 overflow-hidden shadow-xl">
              <div class="w-4 h-0.5 bg-gray-600 rounded-full mx-auto mt-0.5"></div>
              <div class="bg-white h-full m-0.5 rounded-sm p-0.5">
                <div class="w-full h-1 bg-mint-200 rounded mb-0.5"></div>
                <div class="w-3/4 h-0.5 bg-gray-100 rounded mb-0.5"></div>
                <div class="w-full h-4 bg-gray-50 rounded"></div>
              </div>
            </div>
          </div>
          <!-- Content -->
          <div class="p-6">
            <h3 class="text-lg font-bold text-dark mb-2 group-hover:text-mint transition-colors">{project.title}</h3>
            <p class="text-sm text-muted leading-relaxed mb-4">{project.desc}</p>
            <div class="flex flex-wrap gap-2">
              {project.badges.map(badge => (
                <span class="px-3 py-1 text-[10px] font-semibold bg-mint-50 text-mint-600 rounded-full">{badge}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

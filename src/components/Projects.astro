---

<section id="projects" class="py-10 sm:py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="mb-6 sm:mb-12 text-center">
      <p class="text-xs font-semibold tracking-[0.2em] text-mint uppercase mb-1.5 sm:mb-2">Projects</p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-dark mb-2 sm:mb-3">Project Experience</h2>
      <p class="text-xs sm:text-base text-body max-w-xl mx-auto leading-relaxed">Selected QA projects from my CV, covering fintech, WebView POS, HR, recruitment, CRM, AI dashboard, and responsive web platforms.</p>
    </div>

    <!-- Project cards -->
    <div class="relative md:px-14 lg:px-16">
      <button type="button" data-project-prev aria-label="Previous project" class="absolute left-0 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white text-dark shadow-sm transition-all duration-300 ease-out hover:-translate-x-0.5 hover:border-dark hover:bg-light-bg hover:shadow-md focus:outline-none focus:ring-4 focus:ring-gray-100 md:inline-flex md:h-12 md:w-12">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M15 19l-7-7 7-7" /></svg>
      </button>

      <button type="button" data-project-next aria-label="Next project" class="absolute right-0 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-white text-dark shadow-sm transition-all duration-300 ease-out hover:translate-x-0.5 hover:border-dark hover:bg-light-bg hover:shadow-md focus:outline-none focus:ring-4 focus:ring-gray-100 md:inline-flex md:h-12 md:w-12">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M9 5l7 7-7 7" /></svg>
      </button>

      <div class="-mx-4 overflow-x-auto px-4 pb-4 no-scrollbar md:mx-0 md:px-0" data-project-track>
        <div class="flex snap-x snap-mandatory gap-4 sm:gap-5 lg:gap-6">
        {projects.map((project, index) => (
          <div class="group min-w-[72vw] snap-start bg-light-bg rounded-2xl overflow-hidden border border-border hover:border-mint-200 hover:shadow-lg transition-all duration-300 hover:-translate-y-1 md:min-w-[calc(50%-10px)] lg:min-w-[calc((100%-48px)/3)]">
            <!-- Device mockup area -->
            <div class={`relative h-36 overflow-hidden bg-gradient-to-br ${project.color} p-4 sm:h-48 sm:p-5`}>
              <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.22)_0_1px,transparent_1px_18px)]"></div>
              <span class="absolute left-4 top-4 text-4xl font-black text-white/20 sm:text-5xl">{project.num}</span>
              <div class="absolute right-4 top-4 rounded-full bg-white/20 px-3 py-1 text-[9px] font-bold uppercase tracking-wider text-white shadow-sm backdrop-blur">
                QA Project
              </div>

              {project.logo ? (
                <div class="absolute inset-x-5 bottom-5">
                  <div class={`flex h-28 items-center justify-center rounded-2xl border border-white/70 bg-white shadow-xl ring-1 ring-black/5 ${project.logoTone}`}>
                    <img src={project.logo} alt={project.logoAlt} loading="lazy" class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105" />
                  </div>
                </div>
              ) : (
                <div class="absolute inset-x-5 bottom-5 rounded-2xl border border-white/70 bg-white/92 p-3 shadow-xl backdrop-blur">
                  <div class="mb-3 flex items-center justify-between">
                    <div class="flex items-center gap-1">
                      <span class="h-2 w-2 rounded-full bg-red-400"></span>
                      <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
                      <span class="h-2 w-2 rounded-full bg-green-400"></span>
                    </div>
                    <span class="text-[9px] font-bold uppercase tracking-wider text-muted">QA View</span>
                  </div>
                  <div class="grid grid-cols-3 gap-2">
                    {projectVisuals[index].map(item => (
                      <div class="rounded-xl bg-light-bg px-2 py-2 text-center ring-1 ring-border/60">
                        <p class="truncate text-[10px] font-bold text-dark">{item}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <!-- Content -->
            <div class="p-4 sm:p-6">
              <h3 class="text-sm sm:text-lg font-bold text-dark mb-1.5 sm:mb-2 group-hover:text-mint transition-colors">{project.title}</h3>
              <p class="text-[11px] sm:text-sm text-muted leading-relaxed mb-3 sm:mb-4">{project.desc}</p>
              <div class="flex flex-wrap gap-2">
                {project.badges.map(badge => (
                  <span class="px-3 py-1 text-[10px] font-semibold bg-mint-50 text-mint-600 rounded-full">{badge}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const projectTrack = document.querySelector('[data-project-track]');
  const projectPrev = document.querySelector('[data-project-prev]');
  const projectNext = document.querySelector('[data-project-next]');
  let projectIndex = 0;

  const getProjectStep = () => {
    const card = projectTrack?.querySelector('.snap-start');
    if (!(card instanceof HTMLElement)) return 0;
    const styles = window.getComputedStyle(projectTrack?.firstElementChild ?? card);
    const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
    return card.getBoundingClientRect().width + gap;
  };

  const getProjectMaxIndex = () => {
    if (!(projectTrack instanceof HTMLElement)) return 0;
    const step = getProjectStep();
    if (!step) return 0;
    return Math.max(0, Math.round((projectTrack.scrollWidth - projectTrack.clientWidth) / step));
  };

  const syncProjectIndex = () => {
    const step = getProjectStep();
    if (!step || !(projectTrack instanceof HTMLElement)) return;
    projectIndex = Math.min(getProjectMaxIndex(), Math.max(0, Math.round(projectTrack.scrollLeft / step)));
  };

  const scrollProjectToIndex = (nextIndex: number) => {
    if (!(projectTrack instanceof HTMLElement)) return;
    const step = getProjectStep();
    const maxIndex = getProjectMaxIndex();
    projectIndex = Math.min(maxIndex, Math.max(0, nextIndex));
    projectTrack.scrollTo({ left: projectIndex * step, behavior: 'smooth' });
    updateProjectButtons();
  };

  const updateProjectButtons = () => {
    if (!(projectTrack instanceof HTMLElement)) return;
    const setButtonVisible = (button: Element | null, visible: boolean) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.classList.toggle('opacity-0', !visible);
      button.classList.toggle('scale-95', !visible);
      button.classList.toggle('pointer-events-none', !visible);
      button.tabIndex = visible ? 0 : -1;
      button.setAttribute('aria-hidden', String(!visible));
    };

    setButtonVisible(projectPrev, projectIndex > 0);
    setButtonVisible(projectNext, projectIndex < getProjectMaxIndex());
  };

  projectPrev?.addEventListener('click', () => {
    scrollProjectToIndex(projectIndex - 1);
  });

  projectNext?.addEventListener('click', () => {
    scrollProjectToIndex(projectIndex + 1);
  });

  projectTrack?.addEventListener('scroll', () => {
    window.requestAnimationFrame(() => {
      syncProjectIndex();
      updateProjectButtons();
    });
  }, { passive: true });

  window.addEventListener('resize', () => {
    syncProjectIndex();
    scrollProjectToIndex(projectIndex);
  });

  syncProjectIndex();
  updateProjectButtons();
</script>

---
const tools = [
  { name: 'Postman', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z' },
  { name: 'Swagger', icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5' },
  { name: 'MySQL', icon: 'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7zm8-1a6 6 0 110 12 6 6 0 010-12z' },
  { name: 'SaaS', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { name: 'Katalon', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { name: 'JMeter', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'GitHub', icon: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z' },
  { name: 'Google Sheets', icon: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM8 13h3v2H8v-2zm0 4h3v2H8v-2zm5-4h3v2h-3v-2zm0 4h3v2h-3v-2z' },
];
---

<section id="home" class="pt-24 pb-16 lg:pt-32 lg:pb-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left Column -->
      <div class="space-y-6">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-mint-50 border border-mint-200 rounded-full">
          <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse-dot"></span>
          <span class="text-sm font-medium text-mint-600">Available for Opportunities</span>
        </div>

        <!-- Title -->
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase mb-3">Software Quality Assurance Engineer</p>
          <h1 class="text-5xl lg:text-7xl font-bold text-dark leading-tight">
            Adlian<br/>Ramadhan
          </h1>
        </div>

        <!-- Bio -->
        <p class="text-body text-base lg:text-lg leading-relaxed max-w-lg">
          QA Engineer specializing in enterprise web, mobile, fintech, and QRIS payment systems. Focused on delivering stable, reliable, and high-quality digital products.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#projects" class="inline-flex items-center gap-2 px-7 py-3 bg-mint text-white font-semibold rounded-full hover:bg-mint-dark transition-all duration-200 hover:shadow-lg hover:shadow-mint/30">
            View Projects
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#contact" class="inline-flex items-center gap-2 px-7 py-3 border-2 border-gray-300 text-dark font-semibold rounded-full hover:border-mint hover:text-mint transition-all duration-200">
            Contact Me
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
        </div>

        <!-- Tools Bar -->
        <div class="pt-6 border-t border-border mt-6">
          <p class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Tools & Technologies I Use</p>
          <div class="flex flex-wrap gap-5">
            {tools.map(tool => (
              <div class="flex flex-col items-center gap-1.5 group cursor-default">
                <div class="w-10 h-10 rounded-xl bg-light-bg flex items-center justify-center group-hover:bg-mint-50 group-hover:scale-110 transition-all duration-200">
                  <svg class="w-5 h-5 text-muted group-hover:text-mint" fill={tool.name === 'GitHub' ? 'currentColor' : 'none'} stroke={tool.name === 'GitHub' ? 'none' : 'currentColor'} viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon}/></svg>
                </div>
                <span class="text-[10px] text-muted font-medium">{tool.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="relative flex items-end justify-center min-h-[380px] sm:min-h-[450px] lg:min-h-[580px] overflow-visible">
        <!-- Decorative background circle -->
        <div class="absolute bottom-0 right-1/2 translate-x-1/2 w-[280px] sm:w-[350px] lg:w-[420px] h-[280px] sm:h-[350px] lg:h-[420px] bg-gradient-to-b from-mint-100/40 to-mint-50/20 rounded-full"></div>
        <div class="absolute -top-12 -right-12 w-48 lg:w-80 h-48 lg:h-80 bg-mint-100 rounded-full opacity-20 blur-3xl"></div>

        <!-- Profile Photo - Large, blended edges -->
        <div class="relative z-10">
          <div class="profile-blend">
            <img src="/images/profile.png" alt="Adlian Ramadhan" class="w-[300px] sm:w-[380px] lg:w-[500px] h-auto object-contain relative z-10 drop-shadow-2xl" />
          </div>

          <!-- Test Summary Card -->
          <div class="absolute -top-2 -left-4 sm:-top-4 sm:-left-12 bg-white rounded-xl shadow-lg p-2.5 sm:p-3.5 w-40 sm:w-52 animate-float z-20 hidden lg:block">
            <p class="text-[10px] sm:text-xs font-bold text-dark mb-1.5 sm:mb-2">Test Summary</p>
            <div class="space-y-1 sm:space-y-1.5 text-[8px] sm:text-[10px]">
              <div class="flex justify-between"><span class="text-muted">● Total Test Cases</span><span class="font-bold text-dark">1,248</span></div>
              <div class="flex justify-between"><span class="text-green-600">● Passed</span><span class="font-bold text-green-600">1,050</span></div>
              <div class="flex justify-between"><span class="text-red-500">● Failed</span><span class="font-bold text-red-500">32</span></div>
              <div class="flex justify-between"><span class="text-yellow-500">● In Progress</span><span class="font-bold text-yellow-500">166</span></div>
            </div>
          </div>

          <!-- API Response Card -->
          <div class="absolute bottom-16 sm:bottom-28 -left-2 sm:-left-8 bg-gray-900 rounded-xl shadow-lg p-2.5 sm:p-3.5 w-44 sm:w-52 z-20 hidden lg:block" style="animation: float 6s ease-in-out 1s infinite;">
            <div class="flex items-center justify-between mb-1.5 sm:mb-2">
              <p class="text-[8px] sm:text-[10px] font-bold text-white">API Response</p>
              <span class="text-[7px] sm:text-[9px] px-1.5 py-0.5 bg-green-500/20 text-green-400 rounded-full font-medium">200 Ok</span>
            </div>
            <pre class="text-[7px] sm:text-[8px] font-mono text-green-400 leading-relaxed">
{`{
  "status": "success",
  "data": {
    "transactionId": "T2340",
    "amount": 125000,
    "method": "QRIS"
  }
}`}
            </pre>
          </div>

          <!-- Payment Validation Card -->
          <div class="absolute top-8 sm:top-16 -right-2 sm:-right-24 bg-white rounded-xl shadow-lg p-2.5 sm:p-3.5 w-36 sm:w-48 z-20 hidden lg:block" style="animation: float 6s ease-in-out 2s infinite;">
            <div class="flex items-center gap-1.5 sm:gap-2 mb-1">
              <div class="w-5 h-5 sm:w-6 sm:h-6 bg-mint rounded-full flex items-center justify-center">
                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-[8px] sm:text-[10px] font-bold text-dark">Payment Validation</span>
            </div>
            <p class="text-[8px] sm:text-[10px] text-mint font-semibold">QRIS Transaction</p>
            <p class="text-[8px] sm:text-[10px] text-green-500 font-bold">Successful</p>
            <p class="text-[7px] sm:text-[8px] text-muted mt-0.5 sm:mt-1">12 May 2024 • 14:30</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

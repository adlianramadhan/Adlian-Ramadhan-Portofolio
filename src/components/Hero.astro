---
const tools = [
  { name: 'Postman', label: 'API', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z' },
  { name: 'Katalon', label: 'Automation', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { name: 'JMeter', label: 'Performance', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2' },
  { name: 'MySQL', label: 'Database', icon: 'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7zm4 3h8m-8 4h8m-8 4h4' },
  { name: 'Redis', label: 'Cache/Storage', icon: 'M12 3L4 7l8 4 8-4-8-4zM4 12l8 4 8-4M4 17l8 4 8-4' },
  { name: 'Notion', label: 'Project Management', icon: 'M5 4h14v16H5V4zm3 4h8M8 12h8M8 16h5' },
  { name: 'Argo Logs', label: 'Log Monitoring', icon: 'M4 5h16M4 12h16M4 19h16M8 3v4M16 10v4M12 17v4' },
];
---

<section id="home" class="pt-0 pb-0 lg:pt-32 lg:pb-20 bg-white">
  <div class="max-w-7xl mx-auto lg:px-8">
    <!-- ========== MOBILE HERO ========== -->
    <div class="md:hidden">
      <!-- Full-bleed Photo with gradient overlay -->
      <div class="relative h-[70vh] min-h-[420px] max-h-[560px] overflow-hidden">
        <img
          src="/images/profile.png"
          alt="Adlian Ramadhan"
          class="absolute inset-0 w-full h-full object-cover object-[center_20%]"
        />
        <!-- Gradient overlay bottom — using light/white to match site theme -->
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent via-40% to-white"></div>

        <!-- Name overlay at bottom of photo -->
        <div class="absolute inset-x-0 bottom-0 px-5 pb-4 z-10">
          <div class="flex items-center gap-2 mb-1.5">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-mint/90 text-white text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse-dot"></span>
              QA Engineer
            </span>
          </div>
          <h1 class="text-[2rem] font-bold text-dark leading-[1.1] tracking-tight">
            Adlian<br/>Ramadhan
          </h1>
        </div>
      </div>

      <!-- Info section below photo -->
      <div class="px-5 pt-5 pb-6 bg-white">
        <!-- Focus area -->
        <p class="text-mint font-semibold text-xs uppercase tracking-wider mb-1">Focus Area</p>
        <p class="text-xl font-bold text-dark leading-tight">Manual Testing</p>
        <p class="text-xs text-muted mt-1.5 leading-relaxed">Web, mobile, API, and fintech quality assurance</p>

        <!-- Compact stats row -->
        <div class="flex gap-3 mt-4">
          <div class="flex-1 rounded-2xl bg-light-bg border border-border px-4 py-3 text-center">
            <p class="text-lg font-bold text-dark leading-none">4+</p>
            <p class="text-[10px] text-muted font-medium mt-1">Years Exp.</p>
          </div>
          <div class="flex-1 rounded-2xl bg-light-bg border border-border px-4 py-3 text-center">
            <p class="text-lg font-bold text-dark leading-none">15+</p>
            <p class="text-[10px] text-muted font-medium mt-1">Projects</p>
          </div>
          <div class="flex-1 rounded-2xl bg-light-bg border border-border px-4 py-3 text-center">
            <p class="text-lg font-bold text-dark leading-none">QA</p>
            <p class="text-[10px] text-muted font-medium mt-1">Specialist</p>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="flex gap-3 mt-5">
          <a href="#projects" class="flex-1 inline-flex items-center justify-center gap-2 py-3 bg-dark text-white text-sm font-semibold rounded-full hover:bg-gray-800 transition-colors">
            View Projects
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="#contact" class="inline-flex items-center justify-center w-12 h-12 rounded-full border-2 border-border text-dark hover:border-mint hover:text-mint transition-colors shrink-0" aria-label="Contact">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8" /></svg>
          </a>
        </div>

        <!-- Tools row — icon only, compact -->
        <div class="mt-5 pt-4 border-t border-border">
          <p class="text-[10px] font-semibold text-muted uppercase tracking-wider mb-3">Tools & Technologies</p>
          <div class="flex items-center justify-between">
            {tools.map(tool => (
              <div class="flex flex-col items-center gap-1 group cursor-default" title={tool.label}>
                <div class="w-9 h-9 rounded-xl bg-light-bg flex items-center justify-center group-hover:bg-mint-50 transition-colors">
                  <svg class="w-[18px] h-[18px] text-muted group-hover:text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon} /></svg>
                </div>
                <span class="text-[8px] text-muted font-medium leading-tight">{tool.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ========== TABLET HERO ========== -->
    <div class="hidden md:block lg:hidden px-6 pt-24 pb-10">
      <div class="grid min-h-[calc(100vh-6rem)] grid-cols-[0.92fr_1.08fr] items-center gap-6">
        <div class="relative h-[min(62vh,520px)] min-h-[430px] overflow-hidden rounded-[32px] border border-border bg-light-bg shadow-xl shadow-mint/10">
          <img
            src="/images/profile.png"
            alt="Adlian Ramadhan"
            class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-dark/5 via-transparent to-dark/70"></div>
          <div class="absolute inset-x-5 bottom-5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-dark shadow-sm backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>
              QA Engineer
            </span>
            <h1 class="mt-3 text-5xl font-bold leading-[0.95] tracking-tight text-white">
              Adlian<br />Ramadhan
            </h1>
          </div>
        </div>

        <div class="rounded-[32px] border border-border bg-white p-7 shadow-lg shadow-mint/10">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mint">Software Quality Assurance</p>
          <h2 class="mt-3 text-4xl font-bold leading-tight text-dark">Reliable QA for product teams</h2>
          <p class="mt-4 text-sm leading-relaxed text-body">
            Manual testing for web, mobile, API, and fintech products with structured scenarios, edge case validation, and clear issue discovery.
          </p>

          <div class="mt-6 grid grid-cols-3 gap-3">
            <div class="rounded-2xl border border-border bg-light-bg px-4 py-3 text-center">
              <p class="text-xl font-bold leading-none text-dark">4+</p>
              <p class="mt-1 text-[10px] font-medium text-muted">Years Exp.</p>
            </div>
            <div class="rounded-2xl border border-border bg-light-bg px-4 py-3 text-center">
              <p class="text-xl font-bold leading-none text-dark">15+</p>
              <p class="mt-1 text-[10px] font-medium text-muted">Projects</p>
            </div>
            <div class="rounded-2xl border border-border bg-light-bg px-4 py-3 text-center">
              <p class="text-xl font-bold leading-none text-dark">QA</p>
              <p class="mt-1 text-[10px] font-medium text-muted">Specialist</p>
            </div>
          </div>

          <div class="mt-6 flex gap-3">
            <a href="#projects" class="inline-flex flex-1 items-center justify-center gap-2 rounded-full bg-dark px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-gray-800">
              View Projects
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a href="#contact" class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-border text-dark transition-colors hover:border-mint hover:text-mint" aria-label="Contact">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8" /></svg>
            </a>
          </div>

          <div class="mt-6 border-t border-border pt-5">
            <p class="mb-3 text-[10px] font-semibold uppercase tracking-wider text-muted">Tools & Technologies</p>
            <div class="grid grid-cols-4 gap-3">
              {tools.map(tool => (
                <div class="flex min-w-0 flex-col items-center gap-1.5 group cursor-default" title={tool.label}>
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-light-bg transition-colors group-hover:bg-mint-50">
                    <svg class="h-5 w-5 text-muted group-hover:text-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon} /></svg>
                  </div>
                  <span class="text-center text-[9px] font-medium leading-tight text-muted">{tool.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== DESKTOP HERO (unchanged) ========== -->
    <div class="hidden lg:grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center px-4 sm:px-6">
      <div class="space-y-5 sm:space-y-6">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase mb-3">Software Quality Assurance Engineer</p>
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-dark leading-tight">
            Adlian<br />Ramadhan
          </h1>
        </div>

        <p class="text-body text-sm sm:text-base lg:text-lg leading-relaxed max-w-xl">
          I'm a QA Engineer with a primary focus on manual testing and supporting experience in automation. I specialize in web, mobile, and API testing to ensure software quality, usability, and reliability, with experience in structured test scenario creation, edge case validation, and critical issue identification. I thrive by adapting to the team's existing tools and workflows while continuously growing alongside the company.
        </p>

        <div class="flex flex-wrap gap-3 sm:gap-4 pt-2">
          <a href="#projects" class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3 bg-mint text-white font-semibold rounded-full hover:bg-mint-dark transition-all duration-200 hover:shadow-lg hover:shadow-mint/30">
            View Projects
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="#contact" class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3 border-2 border-gray-300 text-dark font-semibold rounded-full hover:border-mint hover:text-mint transition-all duration-200">
            Contact Me
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </a>
        </div>

        <div class="pt-6 border-t border-border mt-6">
          <p class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">Tools & Technologies I Use</p>
          <div class="w-full pb-3 sm:pb-0">
            <div class="grid grid-cols-4 gap-x-3 gap-y-4 sm:flex sm:flex-wrap sm:gap-5">
            {tools.map(tool => (
              <div class="flex min-w-0 flex-col items-center gap-1.5 group cursor-default sm:w-16" title={tool.label}>
                <div class="w-10 h-10 rounded-xl bg-light-bg flex items-center justify-center group-hover:bg-mint-50 group-hover:scale-110 transition-all duration-200">
                  <svg class="w-5 h-5 text-muted group-hover:text-mint" fill={tool.name === 'GitHub' ? 'currentColor' : 'none'} stroke={tool.name === 'GitHub' ? 'none' : 'currentColor'} viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={tool.icon} /></svg>
                </div>
                <span class="text-[10px] text-muted font-medium text-center leading-tight">{tool.name}</span>
              </div>
            ))}
            </div>
          </div>
        </div>
      </div>

      <div class="relative flex items-end justify-center min-h-[580px] overflow-visible">
        <div class="absolute bottom-0 right-1/2 translate-x-1/2 w-[250px] sm:w-[350px] lg:w-[420px] h-[250px] sm:h-[350px] lg:h-[420px] bg-gradient-to-b from-mint-100/40 to-mint-50/20 rounded-full"></div>
        <div class="absolute -top-12 -right-12 w-48 lg:w-80 h-48 lg:h-80 bg-mint-100 rounded-full opacity-20 blur-3xl"></div>

        <div class="relative z-10">
          <div class="profile-blend">
            <img src="/images/profile.png" alt="Adlian Ramadhan" class="w-[260px] sm:w-[380px] lg:w-[500px] h-auto object-contain relative z-10 drop-shadow-2xl" />
          </div>

          <div class="absolute -top-2 -left-6 sm:-top-4 sm:-left-16 bg-white rounded-xl shadow-lg p-2.5 sm:p-3.5 w-40 sm:w-52 animate-float z-20 hidden lg:block">
            <p class="text-[10px] sm:text-xs font-bold text-dark mb-1.5 sm:mb-2">Test Summary</p>
            <div class="space-y-1 sm:space-y-1.5 text-[8px] sm:text-[10px]">
              <div class="flex justify-between"><span class="text-muted">Total Test Cases</span><span class="font-bold text-dark">1,248</span></div>
              <div class="flex justify-between"><span class="text-green-600">Passed</span><span class="font-bold text-green-600">1,050</span></div>
              <div class="flex justify-between"><span class="text-red-500">Failed</span><span class="font-bold text-red-500">32</span></div>
              <div class="flex justify-between"><span class="text-yellow-500">In Progress</span><span class="font-bold text-yellow-500">166</span></div>
            </div>
          </div>

          <div class="absolute bottom-16 sm:bottom-28 -left-2 sm:-left-8 bg-white rounded-xl shadow-lg p-2.5 sm:p-3.5 w-44 sm:w-56 z-20 hidden lg:block" style="animation: float 6s ease-in-out 1s infinite;">
            <p class="text-[8px] sm:text-[10px] font-bold text-dark mb-1.5 sm:mb-2">Testing Methodology</p>
            <div class="space-y-1 text-[8px] sm:text-[10px]">
              <div class="flex items-center gap-1.5 text-muted">
                <span class="text-mint font-bold">&#10003;</span>
                <span>Exploratory Testing</span>
              </div>
              <div class="flex items-center gap-1.5 text-muted">
                <span class="text-mint font-bold">&#10003;</span>
                <span>End-to-End Workflow</span>
              </div>
              <div class="flex items-center gap-1.5 text-muted">
                <span class="text-mint font-bold">&#10003;</span>
                <span>UAT &amp; Requirements</span>
              </div>
              <div class="flex items-center gap-1.5 text-muted">
                <span class="text-mint font-bold">&#10003;</span>
                <span>Bug Tracking &amp; Lifecycle</span>
              </div>
            </div>
          </div>

          <div class="absolute top-8 sm:top-16 -right-2 sm:-right-10 bg-white rounded-xl shadow-lg p-2.5 sm:p-3.5 w-40 sm:w-52 z-20 hidden lg:block" style="animation: float 6s ease-in-out 2s infinite;">
            <div class="flex items-center gap-1.5 sm:gap-2 mb-2">
              <div class="w-5 h-5 sm:w-6 sm:h-6 bg-mint rounded-full flex items-center justify-center">
                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-[8px] sm:text-[10px] font-bold text-dark">Quality Impact</span>
            </div>
            <div class="space-y-1 text-[8px] sm:text-[10px]">
              <div class="flex justify-between gap-2"><span class="text-red-500">Critical Bug</span><span class="font-bold text-red-500">Resolved</span></div>
              <div class="flex justify-between gap-2"><span class="text-blue-500">Edge Case</span><span class="font-bold text-blue-500">Validated</span></div>
              <div class="flex justify-between gap-2"><span class="text-green-600">User Experience</span><span class="font-bold text-green-600">Optimized</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
const stats = [
  { icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', value: '4+', label: 'Years Experience' },
  { icon: 'M4 6h16M4 12h16M4 18h7', value: 'Full-Cycle', label: 'Delivery' },
  { icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4', value: '15+', label: 'Projects Handled' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', value: 'Automation', label: 'Ready' },
  { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', value: 'QA', label: 'Specialist' },
];
---

<section id="about" class="py-6 sm:py-10 lg:py-12 bg-light-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Mobile: horizontal scroll -->
    <div class="flex gap-3 overflow-x-auto no-scrollbar pb-1 sm:hidden">
      {stats.map(stat => (
        <div class="min-w-[120px] flex-shrink-0 bg-white rounded-2xl p-3.5 shadow-sm border border-border flex flex-col items-center justify-center text-center group">
          <div class="w-8 h-8 mx-auto mb-2 rounded-lg bg-mint-50 flex items-center justify-center group-hover:bg-mint group-hover:scale-110 transition-all duration-300">
            <svg class="w-4 h-4 text-mint group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={stat.icon} /></svg>
          </div>
          <p class="text-lg font-bold text-dark leading-tight break-words">{stat.value}</p>
          <p class="text-[10px] text-muted font-medium mt-0.5">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Tablet & Desktop: grid -->
    <div class="hidden sm:grid grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
      {stats.map(stat => (
        <div class="min-h-32 bg-white rounded-2xl p-4 sm:p-6 shadow-sm hover:shadow-md transition-all duration-300 text-center group hover:-translate-y-1 border border-border flex flex-col items-center justify-center">
          <div class="w-9 h-9 sm:w-10 sm:h-10 mx-auto mb-3 rounded-xl bg-mint-50 flex items-center justify-center group-hover:bg-mint group-hover:scale-110 transition-all duration-300">
            <svg class="w-[18px] h-[18px] sm:w-5 sm:h-5 text-mint group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={stat.icon} /></svg>
          </div>
          <p class="text-xl sm:text-2xl lg:text-3xl font-bold text-dark leading-tight break-words max-w-full">{stat.value}</p>
          <p class="text-xs text-muted font-medium mt-1">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
